{
  "$defs": {
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "$ref": "#/$defs/AuthEndpoints"
        },
        "entity": {
          "description": "Entity with email+password fields (auto-detected if omitted)",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "jwt",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AuthConfig",
      "type": "object"
    },
    "AuthEndpoints": {
      "additionalProperties": false,
      "properties": {
        "login": {
          "description": "Generate login endpoint (default: true)",
          "type": "boolean"
        },
        "me": {
          "description": "Generate /me endpoint (default: true)",
          "type": "boolean"
        },
        "register": {
          "description": "Generate register endpoint (default: true)",
          "type": "boolean"
        },
        "setup": {
          "description": "Generate /setup endpoint that bootstraps the first Admin (default: true)",
          "type": "boolean"
        }
      },
      "title": "AuthEndpoints",
      "type": "object"
    },
    "CORSConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "origins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CORSConfig",
      "type": "object"
    },
    "CacheConfig": {
      "additionalProperties": false,
      "properties": {
        "connection_string": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "description": "Cache provider",
          "enum": [
            "redis",
            "memcached",
            "in-memory"
          ],
          "type": "string"
        },
        "ttl_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CacheConfig",
      "type": "object"
    },
    "DeployConfig": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "description": "API domain (e.g. localhost, api.example.com)",
          "type": "string"
        },
        "port": {
          "description": "Exposed application port (default: 8080)",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "DeployConfig",
      "type": "object"
    },
    "EntityDefinition": {
      "additionalProperties": false,
      "description": "An entity. Valid keys: old_name, features, fields, indexes, permissions, seed. There is no `relations:` key — relations are declared as fields of type `relation(Target)` (see the fields description).",
      "properties": {
        "features": {
          "items": {
            "enum": [
              "audit",
              "audit_log",
              "soft_delete",
              "optimistic_lock",
              "event_sourced",
              "cacheable"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Field definitions. Each value is a definition string: `type [modifiers]` (e.g. `string [required, max:255]`). Relations are fields, not a separate key: `relation(Target) [many]` for many-to-many, `relation(Target) [required, on_delete:cascade]`, `relation(Target) [optional, on_delete:set_null]`. `on_delete` accepts cascade|restrict|set_null|no_action. Flag modifiers: `required`, `optional`, `unique`, `hidden`, `readonly`, `primary`, `many`, `email`, `url`, `ipv4`. Key:value modifiers: `min:N`, `max:N`, `gte:N`, `lte:N`, `gt:N`, `lt:N`, `regex:\"...\"`, `default:...`, `old_name:\u003cpreviousName\u003e`. `old_name` is a rename hint for the migration engine: the field was previously named `\u003cpreviousName\u003e`, so bridges can generate a safe `RenameColumn` instead of a destructive drop + add. `hidden` excludes a field from API responses; `readonly` keeps it in responses but excludes it from create/update/patch requests (server-owned). Do not put a space after `:` inside the definition string (`default:5`, not `default: 5`); quoted string defaults are allowed (`default:\"pending\"`).",
          "type": "object"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/IndexDefinition"
          },
          "type": "array"
        },
        "old_name": {
          "description": "Previous entity name — a hint for the migration engine to detect renames",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/EntityPermissions"
        },
        "seed": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "fields"
      ],
      "title": "EntityDefinition",
      "type": "object"
    },
    "EntityPermissions": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delete": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "update": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "EntityPermissions",
      "type": "object"
    },
    "IndexDefinition": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "btree",
            "hash",
            "gist",
            "gin",
            "brin"
          ],
          "type": "string"
        },
        "unique": {
          "type": "boolean"
        }
      },
      "required": [
        "fields"
      ],
      "title": "IndexDefinition",
      "type": "object"
    },
    "InfrastructureConfig": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "description": "Distributed cache store",
          "enum": [
            "redis",
            "memcached",
            "in-memory"
          ],
          "type": "string"
        },
        "queue": {
          "description": "Message broker",
          "enum": [
            "pubsub",
            "rabbitmq",
            "kafka",
            "redis",
            "nats",
            "in-memory"
          ],
          "type": "string"
        },
        "secrets": {
          "description": "Secrets store",
          "enum": [
            "local",
            "kubernetes",
            "azure-keyvault",
            "aws-secrets"
          ],
          "type": "string"
        },
        "storage": {
          "description": "Object/file storage",
          "enum": [
            "local",
            "s3",
            "azure-blob",
            "gcs"
          ],
          "type": "string"
        }
      },
      "title": "InfrastructureConfig",
      "type": "object"
    },
    "MultiTenancy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "column",
            "schema",
            "database"
          ],
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "MultiTenancy",
      "type": "object"
    },
    "PaginationConfig": {
      "additionalProperties": false,
      "properties": {
        "default_page_size": {
          "description": "Default page size (default: 20)",
          "minimum": 1,
          "type": "integer"
        },
        "max_page_size": {
          "description": "Hard cap on page size (default: 200)",
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "PaginationConfig",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "$ref": "#/$defs/CacheConfig"
        },
        "cors": {
          "$ref": "#/$defs/CORSConfig"
        },
        "deploy": {
          "$ref": "#/$defs/DeployConfig"
        },
        "description": {
          "type": "string"
        },
        "infrastructure": {
          "$ref": "#/$defs/InfrastructureConfig"
        },
        "multi_tenancy": {
          "$ref": "#/$defs/MultiTenancy"
        },
        "name": {
          "type": "string"
        },
        "pagination": {
          "$ref": "#/$defs/PaginationConfig"
        },
        "platform": {
          "description": "Target platform version (e.g. net10.0). Defaults to net10.0 for the csharp bridge.",
          "type": "string"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimitConfig"
        },
        "version": {
          "type": "string"
        },
        "versioning": {
          "$ref": "#/$defs/VersioningConfig"
        }
      },
      "required": [
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "RateLimitConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Enable request rate limiting (default: true)",
          "type": "boolean"
        },
        "permit_limit": {
          "description": "Max requests (default: 100)",
          "minimum": 1,
          "type": "integer"
        },
        "policy": {
          "description": "Limiter algorithm (default: fixed)",
          "enum": [
            "fixed",
            "sliding"
          ],
          "type": "string"
        },
        "window_seconds": {
          "description": "Window duration in seconds (default: 60)",
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "RateLimitConfig",
      "type": "object"
    },
    "VersioningConfig": {
      "additionalProperties": false,
      "properties": {
        "default_version": {
          "description": "Default API version (default: 1.0)",
          "type": "string"
        },
        "enabled": {
          "description": "Enable API versioning (default: true)",
          "type": "boolean"
        }
      },
      "title": "VersioningConfig",
      "type": "object"
    }
  },
  "$id": "domain.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "api_style": {
      "enum": [
        "rest",
        "graphql",
        "grpc"
      ],
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig"
    },
    "database": {
      "enum": [
        "postgresql",
        "mysql",
        "sqlite",
        "mssql",
        "mongodb"
      ],
      "type": "string"
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityDefinition"
      },
      "type": "object"
    },
    "enums": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "project": {
      "$ref": "#/$defs/Project"
    }
  },
  "required": [
    "project",
    "entities"
  ],
  "title": "DomainCraft domain.yaml schema",
  "type": "object"
}
