{
  "$defs": {
    "AuthConfig": {
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "$ref": "#/$defs/AuthEndpoints"
        },
        "entity": {
          "description": "Entity with email+password fields (auto-detected if omitted)",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "jwt",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AuthConfig",
      "type": "object"
    },
    "AuthEndpoints": {
      "additionalProperties": false,
      "properties": {
        "login": {
          "description": "Generate login endpoint (default: true)",
          "type": "boolean"
        },
        "me": {
          "description": "Generate /me endpoint (default: true)",
          "type": "boolean"
        },
        "register": {
          "description": "Generate register endpoint (default: true)",
          "type": "boolean"
        }
      },
      "title": "AuthEndpoints",
      "type": "object"
    },
    "CORSConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "origins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CORSConfig",
      "type": "object"
    },
    "CacheConfig": {
      "additionalProperties": false,
      "properties": {
        "connection_string": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "description": "Cache provider",
          "enum": [
            "redis",
            "memcached",
            "in-memory"
          ],
          "type": "string"
        },
        "ttl_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CacheConfig",
      "type": "object"
    },
    "DeployConfig": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "description": "API domain (e.g. localhost, api.example.com)",
          "type": "string"
        },
        "port": {
          "description": "Exposed application port (default: 8080)",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "DeployConfig",
      "type": "object"
    },
    "EntityDefinition": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "items": {
            "enum": [
              "audit",
              "audit_log",
              "soft_delete",
              "optimistic_lock"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/IndexDefinition"
          },
          "type": "array"
        },
        "old_name": {
          "description": "Previous entity name — a hint for the migration engine to detect renames",
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/EntityPermissions"
        },
        "seed": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "fields"
      ],
      "title": "EntityDefinition",
      "type": "object"
    },
    "EntityPermissions": {
      "additionalProperties": false,
      "properties": {
        "create": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delete": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "update": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "EntityPermissions",
      "type": "object"
    },
    "IndexDefinition": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "btree",
            "hash",
            "gist",
            "gin",
            "brin"
          ],
          "type": "string"
        },
        "unique": {
          "type": "boolean"
        }
      },
      "required": [
        "fields"
      ],
      "title": "IndexDefinition",
      "type": "object"
    },
    "MultiTenancy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "column",
            "schema",
            "database"
          ],
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "MultiTenancy",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "cache": {
          "$ref": "#/$defs/CacheConfig"
        },
        "cors": {
          "$ref": "#/$defs/CORSConfig"
        },
        "deploy": {
          "$ref": "#/$defs/DeployConfig"
        },
        "description": {
          "type": "string"
        },
        "multi_tenancy": {
          "$ref": "#/$defs/MultiTenancy"
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "description": "Target platform version (e.g. net9.0, net8.0)",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Project",
      "type": "object"
    }
  },
  "$id": "domain.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "api_style": {
      "enum": [
        "rest",
        "graphql",
        "grpc"
      ],
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/AuthConfig"
    },
    "database": {
      "enum": [
        "postgresql",
        "mysql",
        "sqlite",
        "mssql",
        "mongodb"
      ],
      "type": "string"
    },
    "entities": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityDefinition"
      },
      "type": "object"
    },
    "enums": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "project": {
      "$ref": "#/$defs/Project"
    }
  },
  "required": [
    "project",
    "entities"
  ],
  "title": "DomainCraft domain.yaml schema",
  "type": "object"
}
